# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (Central Shared MongoDB Atlas / Remote Database)
# Example MongoDB Atlas URI: mongodb+srv://<user>:<password>@cluster0.mongodb.net/mlsim?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://admin:securepassword123@cluster0.mongodb.net/mlsim?retryWrites=true&w=majority

# JWT Authentication Secrets
ACCESS_TOKEN_SECRET=supersecretaccesstoken_production_key_change_me
REFRESH_TOKEN_SECRET=supersecretrefreshtoken_production_key_change_me
ACCESS_TOKEN_EXPIRES=15m
REFRESH_TOKEN_EXPIRES=7d

# CORS Allowed Origins
FRONTEND_URL=http://localhost:3000
FRONTEND_URLS=http://localhost:3000,http://localhost:3001,http://localhost:5173,https://mlvisuallab.vercel.app

# Email SMTP Setup (Optional for Email Verification)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=user@example.com
EMAIL_PASS=password
EMAIL_FROM=no-reply@mlvisuallab.com